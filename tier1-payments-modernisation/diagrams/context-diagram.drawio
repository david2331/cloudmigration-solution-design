><mxGeometry x="10" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t1" value="Hybrid private connectivity" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Asynchronous replication" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Scoped deployment" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t4" value="Backup copy, independent custody" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="114" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a5" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="144" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b5" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="144" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t5" value="Pre-built, fenced until DR" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="136" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a6" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="166" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b6" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="166" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t6" value="Sanitised telemetry / findings" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="158" width="244" height="18" as="geometry"/></mxCell><mxCell id="notes" value="Trust and responsibility" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="org"><mxGeometry x="1320" y="250" width="320" height="660" as="geometry"/></mxCell><mxCell id="n0" value="• Workload accounts are separated by legal entity, not by region: each has its own EKS cluster in P and in R." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="35" width="300" height="80" as="geometry"/></mxCell><mxCell id="n1" value="• No default cross-entity routes, shared payment databases or shared Kong instances." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="123" width="300" height="80" as="geometry"/></mxCell><mxCell id="n2" value="• Recovery accounts hold immutable backups and clean-room restores; live Aurora Global Database members stay in the workload account." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="211" width="300" height="95" as="geometry"/></mxCell><mxCell id="n3" value="• Platform owns self-hosted Kong; application teams consume governed routes. No Amazon API Gateway or Konnect." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="314" width="300" height="80" as="geometry"/></mxCell><mxCell id="n4" value="• Logs, backups, artifacts and telemetry need explicit residency, KMS and retention controls; cross-border approval (C05) is not a blanket export permission." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="402" width="300" height="95" as="geometry"/></mxCell><mxCell id="n5" value="• Recovery endpoints exist, but writers and submitters are never active in both regions; traffic switching cannot enforce this." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="505" width="300" height="95" as="geometry"/></mxCell><mxCell id="e0" value="" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a0" target="lg_b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a1" target="lg_b1"><mxGeome
middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Gated recovery action" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Backup copy policy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t4" value="Operator control action" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="114" width="384" height="18" as="geometry"/></mxCell><mxCell id="steps" value="Ordered regional recovery" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="460" height="520" as="geometry"/></mxCell><mxCell id="st0" value="&lt;b&gt;1 Detect and declare&lt;/b&gt; — record disruption time, scope, replication health; owner authorises runbook." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="32" width="440" height="64" as="geometry"/></mxCell><mxCell id="st1" value="&lt;b&gt;2 Fence before promotion&lt;/b&gt; — revoke old writer and submitter authority with an enforceable lease; DNS is not fencing." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="100" width="440" height="64" as="geometry"/></mxCell><mxCell id="st2" value="&lt;b&gt;3 Assess loss&lt;/b&gt; — replicated ledger/outbox position, ambiguous acknowledgements, partner-side submissions." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="168" width="440" height="64" as="geometry"/></mxCell><mxCell id="st3" value="&lt;b&gt;4 Promote&lt;/b&gt; — approved Aurora global failover; verify single writer and regional secrets." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="236" width="440" height="64" as="geometry"/></mxCell><mxCell id="st4" value="&lt;b&gt;5 Rebuild work&lt;/b&gt; — replay only surviving outbox into R-local SQS with de-duplication." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="304" width="440" height="64" as="geometry"/></mxCell><mxCell id="st5" value="&lt;b&gt;6 Validate then switch&lt;/b&gt; — probes and canaries; flip ARC routing control; enable safe journeys only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="372" width="440" height="64" as="geometry"/></mxCell><mxCell id="st6" value="&lt;b&gt;7 Fail back separately&lt;/b&gt; — rebuild P as secondary; planned switchover later." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="steps"><mxGeometry x="10" y="440" width="440" height="64" as="geometry"/></mxCell><mxCell id="obj" value="Draft objectives (unmeasured)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=
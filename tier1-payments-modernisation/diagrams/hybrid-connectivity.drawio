=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Inspected, entity-scoped route" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Routed inspection, symmetric return" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="384" height="18" as="geometry"/></mxCell><mxCell id="contracts" value="Routing and security contracts" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="460" height="910" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;Diversity:&lt;/b&gt; two DX routes with evidenced carrier, location, router and last-mile diversity; both regional TGWs reachable independently." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="35" width="440" height="100" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;VPN fallback:&lt;/b&gt; tunnels to each country&#x27;s TGW; validate BGP preference, MTU/MSS and degraded capacity for critical journeys." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="143" width="440" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Encryption:&lt;/b&gt; DX is not encrypted. Require TLS/mTLS end-to-end or an engineered IPsec overlay." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="251" width="440" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Segmentation:&lt;/b&gt; separate TGW route domains per entity; no default cross-entity propagation or automatic P&lt;-&gt;R peering." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="359" width="440" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Inspection:&lt;/b&gt; per-AZ Network Firewall endpoints with appliance mode and symmetric routes. Only routed traffic is inspected; TLS is not decrypted automatically." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="467" width="440" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Private ingress:&lt;/b&gt; internal ALB -&gt; Kong -&gt; ClusterIP. SGs, NetworkPolicy and admission prevent direct exposure." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="575" width="440" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;DNS:&lt;/b&gt; Route 53 Resolver inbound/outbound endpoints in both regions; private naming is not authorisation." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="683" width="440" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Readiness:&lt;/b&gt; prove reachability to both regions. Route availability must never enable dual writers." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="791" width="440" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a0" target="lg_b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="strokeColor=#B85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;html=1;fontSiz
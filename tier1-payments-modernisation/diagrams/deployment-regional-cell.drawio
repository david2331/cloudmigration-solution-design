r=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t1" value="Private hybrid ingress" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Control / configuration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Storage replication" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t4" value="IAM / endpoint policy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="114" width="384" height="18" as="geometry"/></mxCell><mxCell id="notes" value="Availability and implementation constraints" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="460" height="870" as="geometry"/></mxCell><mxCell id="n0" value="• At least three ready Kong replicas spread across AZs with topology spread, PDBs and tested spare capacity for one AZ loss. Replica count alone is not resilience." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="35" width="440" height="100" as="geometry"/></mxCell><mxCell id="n1" value="• Platform owns Gateway/GatewayClass, allowedRoutes, baseline plugins and private Kong administration; applications own namespaced HTTPRoutes only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="150" width="440" height="100" as="geometry"/></mxCell><mxCell id="n2" value="• Kong -&gt; application hop is TLS/mTLS. No Amazon API Gateway or Konnect. DB-less uses Git/Kubernetes desired state, not decK sync." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="265" width="440" height="100" as="geometry"/></mxCell><mxCell id="n3" value="• Aurora has a single regional writer; storage replicates across AZs. Global Database to R is asynchronous: AZ-loss zero loss is not regional zero RPO." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="380" width="440" height="100" as="geometry"/></mxCell><mxCell id="n4" value="• In R before promotion: Aurora secondary readers replace the writer and payment submitters stay disabled; everything else is pre-provisioned." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="495" width="440" height="100" as="geometry"/></mxCell><mxCell id="n5" value="• Terraform owns AWS provisioning; Helm owns Kubernetes workloads; LB Controller owns its ALBs. Never declare a resource twice." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="610" width="440" height="100" as="geometry"/></mxCell><mxCell id="n6" value="• AZ-a/b/c are logical slots: map actual AZ IDs per account. Confirm EKS, endpoint, backup and engine support in both regions (S6, S33)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="notes"><mxGeometry x="10" y="725" width="440" height="100" as="geometry"/></mxCell><mxCell id="e0" value="" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a0" target="lg_b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a1" target="lg_b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="strokeColor=#147EBA;strokeWidth=1.2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a2" target="lg_b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="strokeColor=#C925D1;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a3" target="lg_b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="strokeColor=#DD344C;strokeWidth=1.2;dashed=1;endArrow=open;endFill=0;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a4" target="lg_b4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="HTTPS" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clients" target="waf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="184" y="250"/><mxPoint x="134" y="250"/></Array></mxGeometry></mxCell><mxCell id="e6" value="WAF inspection" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="ing" source="waf" target="pub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="HTTPS, internal DNS" style="strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hybrid" target="priv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="884" y="250"/><mxPoint x="784" y="250"/></Array></mxGeometry></mxCell><mxCell id="e8" value="TLS" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="vpc" source="pub" target="konga"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="274" y="180"/><mxPoint x="84" y="180"/></Array></mxGeometry></mxCell><mxCell id="e9" value="" style="strokeColor=#8C4FFF;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exi
="plat"><mxGeometry x="820" y="40" width="48" height="46.56" as="geometry"/></mxCell><mxCell id="app" value="Application namespaces — scoped RBAC" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#EEF3FC;strokeColor=#326CE5;dashed=1;fontColor=#326CE5;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="eks"><mxGeometry x="20" y="210" width="960" height="170" as="geometry"/></mxCell><mxCell id="route" value="Approved namespaced&lt;br&gt;HTTPRoutes" style="aspect=fixed;html=1;dashed=0;whiteSpace=wrap;fillColor=#326CE5;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#232F3E;outlineConnect=0;shape=mxgraph.kubernetes.icon2;prIcon=ing;" vertex="1" parent="app"><mxGeometry x="50" y="40" width="48" height="46.56" as="geometry"/></mxCell><mxCell id="svc" value="ClusterIP services -&gt; payment&lt;br&gt;pods (authZ + idempotency)" style="aspect=fixed;html=1;dashed=0;whiteSpace=wrap;fillColor=#326CE5;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#232F3E;outlineConnect=0;shape=mxgraph.kubernetes.icon2;prIcon=svc;" vertex="1" parent="app"><mxGeometry x="320" y="40" width="48" height="46.56" as="geometry"/></mxCell><mxCell id="workers" value="Outbox publisher / queue&lt;br&gt;workers (fenced submitters)" style="aspect=fixed;html=1;dashed=0;whiteSpace=wrap;fillColor=#326CE5;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#232F3E;outlineConnect=0;shape=mxgraph.kubernetes.icon2;prIcon=pod;" vertex="1" parent="app"><mxGeometry x="660" y="40" width="48" height="46.56" as="geometry"/></mxCell><mxCell id="data" value="Private data / AWS service boundary" styl
trokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="side"><mxGeometry x="106" y="400" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend" value="Legend" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="acct"><mxGeometry x="1320" y="40" width="320" height="144" as="geometry"/></mxCell><mxCell id="lg_a0" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="34" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b0" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="34" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t0" value="Request / data path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="26" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t1" value="Private hybrid ingress" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Asynchronous / at-least-once" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Control-plane reconciliation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="244" height="18" as="geometry"/></mxCell><mxCell id="lg_a4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b4" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="122" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t4" value="Identity / secret access" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="114" width="244" height="18" as="geometry"/></mxCell><mxCell id="contracts" value="Controller and security contracts" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="acct"><mxGeometry x="1320" y="200" width="320" height="630" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;Entry:&lt;/b&gt; LB Controller owns Kong-fronting ALBs; KIC owns HTTPRoute reconciliation. No two controllers own the same object." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="35" width="300" height="90" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;Kong admin:&lt;/b&gt; private Admin API reached only by KIC and platform operators. DB-less: no config database, no decK sync." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="132" width="300" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Route delegation:&lt;/b&gt; platform owns GatewayClass, Gateway, allowedRoutes; apps get namespaced HTTPRoutes only." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="229" width="300" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Bypass prevention:&lt;/b&gt; SGs, NetworkPolicy and admission block public LoadBalancer/NodePort services. ClusterIP is not a boundary." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="326" width="300" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Identity:&lt;/b&gt; Kong authentication never replaces application authorisation, entity checks or idempotency." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="423" width="300" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Semantics:&lt;/b&gt; ledger + outbox commit atomically; SQS is regional and not transactional with the commit." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="contracts"><mxGeometry x="10" y="520" width="300" height="90" as="geometry"/></mxCell><mxCell id="e0" value="" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a0" target=
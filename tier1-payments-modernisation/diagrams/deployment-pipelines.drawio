<mxfile host="drawio" type="device"><diagram id="deployment-pipelines" name="Deployment pipelines — three delivery layers; platform Kong release is a foundation subpipeline"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Deployment pipelines — three delivery layers; platform Kong release is a foundation subpipeline" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1660" height="30" as="geometry"/></mxCell><mxCell id="gh" value="GitHub trust boundary" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F6F8FA;strokeColor=#24292F;dashed=0;fontColor=#24292F;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1180" height="170" as="geometry"/></mxCell><mxCell id="ghlogo" value="GitHub" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#232F3E;shape=mxgraph.weblogos.github;" vertex="1" parent="gh"><mxGeometry x="30" y="40" width="40" height="40" as="geometry"/></mxCell><mxCell id="pr" value="Untrusted pull requests&lt;br&gt;checks only, no deploy creds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="gh"><mxGeometry x="130" y="50" width="210" height="60" as="geometry"/></mxCell><mxCell id="reviewed" value="Protected reviewed&lt;br&gt;commit / workflow" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="gh"><mxGeometry x="390" y="50" width="200" height="60" as="geometry"/></mxCell><mxCell id="build" value="Isolated build + scan&lt;br&gt;image, chart, SBOM, provenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="gh"><mxGeometry x="640" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="approval" value="Protected environment&lt;br&gt;approval (branches, reviewers)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="gh"><mxGeometry x="920" y="50" width="230" height="60" as="geometry"/></mxCell><mxCell id="tool" value="Platform tooling account — connected deployment trust boundary" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;dashed=0;spacingLeft=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1180" height="180" as="geometry"/></mxCell><mxCell id="ecr" value="ECR immutable image + OCI chart&lt;br&gt;digests; signed manifest; R copies" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="tool"><mxGeometry x="110" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="runner" value="Ephemeral deployment runners&lt;br&gt;(no PR code, per trust tier)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="tool"><mxGeometry x="540" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="sts" value="AWS STS: OIDC exact aud/sub&lt;br&gt;layer + entity + env roles" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.sts;" vertex="1" parent="tool"><mxGeometry x="940" y="50" width="48" height="48" as="geometry"/></mxCell><mxCell id="tgt" value="Selected entity account + environment (P or R)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;fontColor=#CD2264;dashed=0;spacingLeft=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1180" height="670" as="geometry"/></mxCell><mxCell id="l1" value="Layer 1 — Foundation (platform team)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="tgt"><mxGeometry x="20" y="40" width="360" height="400" as="geometry"/></mxCell><mxCell id="f" value="Terraform: accounts, VPC,&lt;br&gt;EKS, IAM boundaries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="l1"><mxGeometry x="30" y="50" width="300" height="60" as="geometry"/></mxCell><mxCell id="platform" value="Foundation subpipeline (Helm):&lt;br&gt;controllers, Kong, platform policy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="l1"><mxGeometry x="30" y="170" width="300" height="60" as="geometry"/></mxCell><mxCell id="state" value="S3 Terraform state — versioning,&lt;br&gt;SSE-KMS, native lockfile" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="l1"><mxGeometry x="156" y="290" width="48" height="48" as="geometry"/></mxCell><mxCell id="l2" value="Layer 2 — Application infrastructure (product team)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="tgt"><mxGeometry x="400" y="40" width="360" height="400" as="geometry"/></mxCell><mxCell id="infra" value="Terraform: Aurora, SQS, S3, IAM,&lt;br&gt;secret metadata, alarms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="l2"><mxGeometry x="30" y="50" width="300" height="60" as="geometry"/></mxCell><mxCell id="aur" value="Aurora" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="l2"><mxGeometry x="50" y="190" width="48" height="48" as="geometry"/></mxCell><mxCell id="sqs" value="SQS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="l2"><mxGeometry x="156" y="190" width="48" height="48" as="geometry"/></mxCell><mxCell id="sec" value="Secrets" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="l2"><mxGeometry x="260" y="190" width="48" height="48" as="geometry"/></mxCell><mxCell id="l3" value="Layer 3 — Application code (product team)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="tgt"><mxGeometry x="780" y="40" width="380" height="400" as="geometry"/></mxCell><mxCell id="app" value="Helm: services, immutable images,&lt;br&gt;approved HTTPRoutes, DB migrations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="l3"><mxGeometry x="30" y="50" width="320" height="60" as="geometry"/></mxCell><mxCell id="eks" value="Private EKS — three AZs,&lt;br&gt;namespace-scoped RBAC" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="l3"><mxGeometry x="166" y="190" width="48" height="48" as="geometry"/></mxCell><mxCell id="verify" value="Canary / SLO / payment probes — approve promotion or compatible rollback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="tgt"><mxGeometry x="20" y="470" width="1140" height="50" as="geometry"/></mxCell><mxCell id="independent" value="Independent approved emergency runner — prepositioned artifacts, no GitHub dependency; audited recovery only, DR safety gates still apply" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#232F3E;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="tgt"><mxGeometry x="20" y="550" width="1140" height="60" as="geometry"/></mxCell><mxCell id="legend" value="Legend" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="460" height="122" as="geometry"/></mxCell><mxCell id="lg_a0" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="34" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b0" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="34" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t0" value="Promotion flow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="26" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b1" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="56" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t1" value="Scoped role assumption / deploy" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="48" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b2" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="78" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t2" value="Versioned contract / output" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="70" width="384" height="18" as="geometry"/></mxCell><mxCell id="lg_a3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="10" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_b3" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="56" y="100" width="2" height="2" as="geometry"/></mxCell><mxCell id="lg_t3" value="Emergency-only path" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend"><mxGeometry x="66" y="92" width="384" height="18" as="geometry"/></mxCell><mxCell id="rules" value="Identity, artifact and rollback rules" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;fillColor=#F7F7F7;strokeColor=#999999;dashed=0;fontColor=#333333;spacingLeft=8;spacingTop=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="230" width="460" height="890" as="geometry"/></mxCell><mxCell id="n0" value="• Issuer token.actions.githubusercontent.com, aud = sts.amazonaws.com, exact sub. No org- or repo-wide wildcards for production." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="35" width="440" height="110" as="geometry"/></mxCell><mxCell id="n1" value="• An environment subject does not contain the branch: enforce deployment branches, reviewers and workflow-change control separately." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="155" width="440" height="110" as="geometry"/></mxCell><mxCell id="n2" value="• Roles split by layer + entity + environment; limit session duration, iam:PassRole and EKS access entries." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="275" width="440" height="110" as="geometry"/></mxCell><mxCell id="n3" value="• Build once, promote the same digest; verify signatures in each registry. Never deploy a mutable tag." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="395" width="440" height="110" as="geometry"/></mxCell><mxCell id="n4" value="• Apply only the approved saved Terraform plan; drift or state change means re-plan and re-approve." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="515" width="440" height="110" as="geometry"/></mxCell><mxCell id="n5" value="• AWS LB Controller owns Kong-fronting ALBs; Terraform must not also declare them. Helm and Terraform never own the same workload." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="635" width="440" height="110" as="geometry"/></mxCell><mxCell id="n6" value="• Expand/contract migrations. Roll back only to approved digests with proven DB compatibility; otherwise roll forward." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="rules"><mxGeometry x="10" y="755" width="440" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a0" target="lg_b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="strokeColor=#ED7100;strokeWidth=1.5;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a1" target="lg_b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="strokeColor=#147EBA;strokeWidth=1.2;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a2" target="lg_b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="strokeColor=#B85450;strokeWidth=1.5;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;html=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#ffffff;rounded=1;noEdgeStyle=1;" edge="1" parent="legend" source="lg_a3" target="lg_b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCel